<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script
      src="https://kit.fontawesome.com/764ed6c5a4.js"
      crossorigin="anonymous"
    ></script>
    <title>Your Book Was Bought - Qampus</title>

    <%- include("./bookBoughtStyles") %>
  </head>
  <body>
    <header>
      <img
        class="logo"
        src="https://firebasestorage.googleapis.com/v0/b/qampus-app-4f577.appspot.com/o/Qampus_logo_grey.png?alt=media&token=22e21215-0f00-46df-9d32-79df68cf22dd"
        alt="qampus"
      />
    </header>
    <section>
      <div class="book">
        <!-- Book body | part with image -->
        <div class="book__imageContainer">
          <img
            loading="eager"
            class="book__image"
            src="<%= book?.frontCover %>"
            alt="<%= book?.title %>"
          />
        </div>

        <!-- Book footer | part with delete and edit button -->
        <div class="book__footer">
          <div class="book__footerLeft">
            <h4 class="title--light"><%= book?.title %></h4>
            <p><%= "R" + book?.price %></p>
          </div>
        </div>
      </div>

      <div class="textSection">
        <h4>Hi <%= seller.firstName %></h4>
        <p>
          <%= [buyer.firstName, buyer.lastName].join(" ") %> has shown an
          interest in your book. View their message and arrange with them the
          exchange.
        </p>

        <a href="https://qampus.co.za/chats">Contact <%= buyer.firstName %></a>
      </div>
    </section>
  </body>
</html>
