<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password</title>

    <%- include("./forgotPasswordStyles.ejs") %>
  </head>
  <body>
    <header>
      <img
        class="logo"
        src="https://firebasestorage.googleapis.com/v0/b/qampus-app-4f577.appspot.com/o/Qampus_logo_grey.png?alt=media&token=22e21215-0f00-46df-9d32-79df68cf22dd"
        alt="qampus"
      />
    </header>

    <section>
      <h1>You requested a password reset</h1>
      <p>
        We received a request for a password reset. We are sending this email to
        make sure it was from you. Please use this secure password to access
        your account and change your password from your profile.
      </p>
      <div class="password">
        <span class="title">Your one time use password</span>
        <span class="passwordText"><%= password %> </span>
      </div>
    </section>

    <footer>
      If you did not request this change, then someone else may have tried to
      access account. We will monitor it and if there is any suspicious activity
      we will let you know what steps can be taken.
      <strong>You can change your password</strong> as a safety precaution.
    </footer>
  </body>
</html>
