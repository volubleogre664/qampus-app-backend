<style>
  * {
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen,
      Ubuntu, Cantarell, "Open Sans", "Helvetica Neue", sans-serif;
  }

  body {
    display: flex;
    align-items: center;
    flex-direction: column;
    gap: 20px;
  }

  header {
    width: 100%;
    background-color: transparent;
    /* margin-bottom: px; */
    padding: 10px;
    border-radius: 5px;
    box-sizing: border-box;
    text-align: center;
  }

  section {
    max-width: 450px;
  }

  header img {
    height: 60px;
    object-fit: contain;
    margin: auto;
  }

  .book {
    width: 250px;
    background: #fff;
    position: relative;
    overflow: hidden;
    height: auto;
    border-radius: 8px;
    margin: auto;
    margin-bottom: 15px;
    border: 1.5px solid #000;
    box-shadow: 2px 1px 1px rgba(0, 0, 0, 0.2), 2px 1px 1px rgba(0, 0, 0, 0.2);
  }

  .book__image {
    width: 100%;
    max-height: 280px;
    object-fit: fill;
  }

  .book__footer {
    display: flex;
    gap: 10px;
    align-items: center;
    padding: 10px;
    padding-bottom: 0;
    box-sizing: border-box;
    width: 100%;
  }

  .book__footer h4 {
    margin: 0;
    flex: 1;
    color: #000 !important;
    display: -webkit-inline-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .book__footer p {
    color: #000;
  }

  .textSection {
    gap: 10px;
  }

  .textSection > * {
    display: block;
    width: 100%;
    margin: auto;
    text-align: center;
    margin-bottom: 10px;
    box-sizing: border-box;
  }

  .textSection h4 {
    font-size: 1.5rem;
    font-weight: 800;
    color: #024df0;
  }

  .textSection p {
    font-size: 1.1rem;
    font-weight: 300;
  }

  .textSection a {
    padding: 20px 20px;
    font-size: 0.95rem;
    max-width: 300px;
    color: #fff;
    font-weight: 500;
    background-color: #4093ff;
    text-decoration: none;
    border-radius: 6px;
  }
</style>
